# API Keys — add these as GitHub repo secrets for the automated workflow
# For local development, copy this file to .env and fill in your keys

# Apify — https://apify.com (free tier: ~$5/month credit)
# Used for Zillow and Zumper scrapers
APIFY_API_KEY=

# Resend — https://resend.com (free: 100 emails/day)
# Used for email notifications to the group
RESEND_API_KEY=

# RentCast — https://rentcast.io/api (free: 50 requests/month)
# Currently disabled in config.yaml
RENTCAST_API_KEY=

# RapidAPI — https://rapidapi.com (free tiers vary)
# Currently disabled in config.yaml (was used for old Zillow/Redfin collectors)
RAPIDAPI_KEY=
